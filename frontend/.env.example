# URL pública da API Express incluída em /backend
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Número de WhatsApp da loja, formato internacional sem "+" nem espaços (DDI+DDD+número).
# Sem o prefixo NEXT_PUBLIC_ de propósito: assim ele fica só no servidor e nunca aparece
# no código JavaScript que o navegador do cliente baixa.
WHATSAPP_NUMBER=5511999999999
