PORT=3000
NODE_ENV=development

# PostgreSQL (Railway fornece essa URL automaticamente ao provisionar o banco)
DATABASE_URL=postgresql://user:password@host:port/database

# Autenticação
JWT_SECRET=troque_por_um_segredo_forte_e_aleatorio

# CORS — domínio(s) do frontend em produção, separados por vírgula
CORS_ORIGIN=https://vanillaparfums.vercel.app

# Seed do usuário admin inicial (rodar apenas uma vez: npm run seed)
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=defina_uma_senha_forte

